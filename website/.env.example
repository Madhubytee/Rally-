# Rally website — environment template
# Copy to .env.local and adjust. .env.local is gitignored; this file is committed.
#
# Next.js only exposes NEXT_PUBLIC_* variables to browser code, and it inlines
# them into the bundle at build time. Everything below is therefore PUBLIC.
# A real secret (database URL, private API key) goes in an unprefixed var and
# is read only from server components or route handlers.

# --- app ---
NEXT_PUBLIC_APP_NAME=Rally
NEXT_PUBLIC_DEFAULT_CITY=Gainesville

# Standing water sites preloaded from GLOBE Observer before anyone reports.
# Shown in the landing page callout.
NEXT_PUBLIC_SEEDED_SITE_COUNT=412

# --- map starting view ---
NEXT_PUBLIC_MAP_CENTER_LAT=29.6516
NEXT_PUBLIC_MAP_CENTER_LNG=-82.3248
NEXT_PUBLIC_MAP_DEFAULT_ZOOM=13

# Tile provider token (Mapbox / MapTiler / etc). Blank uses a keyless source.
# Use a domain-restricted token — never a secret key, it ships to the browser.
NEXT_PUBLIC_MAP_TILE_TOKEN=

# --- NASA GLOBE Observer ---
# Source of the seeded standing water sites.
NEXT_PUBLIC_GLOBE_API_BASE=https://api.globe.gov/search/v1
NEXT_PUBLIC_GLOBE_PROTOCOL=mosquito_habitat_mapper

# --- dev server ---
# next dev defaults to 3000; override with `npm run dev -- -p 3001`.
PORT=3000
