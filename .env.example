# Rally — environment template
# Copy to .env and fill in. .env is gitignored; this file is committed.
#
# NOTE: nothing in index.html reads these yet — the landing page ships with
# hardcoded demo data. These are the keys the real map/board will need.

# --- dev server ---
DEV_PORT=5173
PREVIEW_PORT=4173

# --- app ---
# Only VITE_-prefixed vars are exposed to browser code by Vite.
VITE_APP_NAME=Rally
VITE_DEFAULT_CITY=Gainesville

# Map starting view
VITE_MAP_CENTER_LAT=29.6516
VITE_MAP_CENTER_LNG=-82.3248
VITE_MAP_DEFAULT_ZOOM=13

# Map tile provider token (Mapbox/MapTiler/etc). Leave blank to use a keyless
# tile source. Anything VITE_-prefixed is PUBLIC in the browser bundle —
# use a domain-restricted token, never a secret key.
VITE_MAP_TILE_TOKEN=

# NASA GLOBE Observer — source of the seeded standing water sites
VITE_GLOBE_API_BASE=https://api.globe.gov/search/v1
VITE_GLOBE_PROTOCOL=mosquito_habitat_mapper
