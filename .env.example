# Rally — environment template
# Copy to .env.local and adjust. .env.local is gitignored; this file is committed.
#
# Next.js only exposes NEXT_PUBLIC_* variables to browser code, and it inlines
# them into the bundle at build time. Everything below is therefore PUBLIC.
# A real secret (a service-role key, a private API key) goes in an unprefixed
# var and is read only from server components or route handlers.

# --- app ---
NEXT_PUBLIC_APP_NAME=Rally
NEXT_PUBLIC_DEFAULT_CITY=Gainesville

# --- map starting view ---
NEXT_PUBLIC_MAP_CENTER_LAT=29.6516
NEXT_PUBLIC_MAP_CENTER_LNG=-82.3248
NEXT_PUBLIC_MAP_DEFAULT_ZOOM=13

# Basemap style. OpenFreeMap needs no key, no account and has no request cap.
# Swapping providers (MapTiler, CARTO) is a change to this one line.
NEXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/positron

# --- NASA GLOBE Observer ---
# The search API is open: no key, no registration, CORS enabled.
# (The key-gated API at api.globe.gov/docs is the *submission* API. Different
# service, not needed here.)
NEXT_PUBLIC_GLOBE_API_BASE=https://api.globe.gov/search/v1
NEXT_PUBLIC_GLOBE_PROTOCOL=mosquito_habitat_mapper

# --- Supabase ---
# Dashboard → Project Settings → Data API  (and → API Keys for the key)
#
# Both of these are meant to be public and ship to the browser. The anon key is
# safe to expose *because* row-level security is on — the policies in
# data/schema.sql are what actually protect the data, not the key.
#
# Leave these blank and the app runs in demo mode: everything works, nothing
# persists past a reload.
#
# NEVER put the service_role key in a NEXT_PUBLIC_ var. It bypasses every RLS
# policy and would hand any visitor full read/write on the database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
